<resources>
    <!-- Window theme of the Compose host: no action bar, edge-to-edge. ViFiTheme (Compose) draws everything; the
         window, system bars and the Android 12+ splash use the same background as VifiLightColors.background. -->
    <style name="Theme.ViFi" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background_light</item>
    </style>
</resources>
