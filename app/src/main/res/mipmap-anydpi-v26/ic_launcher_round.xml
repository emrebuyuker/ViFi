<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon (API 26+): brand orange behind the white "VF" mark; the monochrome layer is the same
     mark, tinted by the launcher for Android 13+ themed icons. Older versions use the PNGs of the same name. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
