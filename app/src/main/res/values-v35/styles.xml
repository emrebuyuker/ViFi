<resources>
    <!-- Temporary: legacy XML screens don't handle window insets yet. targetSdk 35 forces edge-to-edge;
         this opt-out is ignored from targetSdk 36 on. Remove once FM-22 (Compose host + insets) lands. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>

    <style name="LegacyLightTheme" parent="Base.Theme.AppCompat.Light">
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
