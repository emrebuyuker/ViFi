<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        The admin's location picker (4.1.0, MAP-01) asks for this once, when it opens, only to center the map on
        the admin's district; the location is never stored, logged or sent. Approximate and foreground only (product
        owner, 2026-10-30): the district is all the picker needs, and FINE would need Play's new justification.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Kept out even if a library asks for it. -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        tools:node="remove" />
    <!-- Places merges this for its "current place" API (Wi-Fi as a location signal); the picker never uses it. -->
    <uses-permission
        android:name="android.permission.ACCESS_WIFI_STATE"
        tools:node="remove" />

    <application>
        <!--
            Places' own autocomplete screen. The picker has its own search, so without this entry R8 and the
            resource shrinker drop the widget's code and layouts.
        -->
        <activity
            android:name="com.google.android.libraries.places.widget.AutocompleteActivity"
            tools:node="remove" />
        <!-- Maps SDK key from local.properties (MAPS_API_KEY); empty without one, and the picker then shows no map. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${mapsApiKey}" />
    </application>
</manifest>
